{"$id":"https://example.com/schemas/course-config.schema.json","$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"definitions":{"contentBlock":{"additionalProperties":false,"allOf":[{"if":{"properties":{"type":{"const":"text"}}},"then":{"required":["html"]}},{"if":{"properties":{"type":{"const":"callout"}}},"then":{"required":["html"]}},{"if":{"properties":{"type":{"const":"list"}}},"then":{"required":["items"]}},{"if":{"properties":{"type":{"const":"image"}}},"then":{"required":["src","alt"]}},{"if":{"properties":{"type":{"const":"video"}}},"then":{"required":["src","alt"]}}],"properties":{"alt":{"description":"REQUIRED for image/video blocks. No exceptions.","type":"string"},"caption":{"type":"string"},"html":{"description":"HTML for text and callout blocks. Author-controlled; the engine renders it as-is.","type":"string"},"items":{"items":{"type":"string"},"type":"array"},"src":{"type":"string"},"type":{"enum":["text","list","image","video","callout"],"type":"string"}},"required":["type"],"type":"object"},"screen":{"additionalProperties":false,"allOf":[{"if":{"properties":{"type":{"const":"content"}}},"then":{"required":["blocks"]}},{"if":{"properties":{"type":{"const":"multipleChoice"}}},"then":{"required":["prompt","options","correctOptionId"]}},{"if":{"properties":{"type":{"const":"scenario"}}},"then":{"required":["prompt","choices"]}}],"properties":{"blocks":{"description":"Content screens only.","items":{"$ref":"#/definitions/contentBlock"},"type":"array"},"choices":{"description":"Scenario branches. Each choice routes to a screen via next.","items":{"additionalProperties":false,"properties":{"feedback":{"description":"Consequence shown after choosing. Required — learners must see outcomes.","type":"string"},"id":{"type":"string"},"next":{"description":"Screen id to go to after this choice. Must exist.","type":"string"},"scoreDelta":{"description":"Points added (or removed) by this choice.","type":"number"},"text":{"type":"stri